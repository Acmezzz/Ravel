{
  "name": "@ravel/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure local Electron desktop shell for Ravel Agent (React + MUI + Tailwind workbench)",
  "author": "Ravel",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "vite build",
    "watch:renderer": "vite build --watch",
    "dev": "vite build --watch",
    "typecheck": "node scripts/check-electron-syntax.mjs",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "sdk-check": "node scripts/sdk-check.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "rebuild:native": "electron-rebuild -v 44.0.0 -w node-pty --force",
    "migration:smoke": "node scripts/migration-smoke.mjs",
    "package:dir": "electron-builder --dir",
    "package": "electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.13.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "@xyflow/react": "12.11.5",
    "elkjs": "0.12.0",
    "highlight.js": "11.10.0",
    "lucide-react": "1.34.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.1",
    "remark-gfm": "4.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.4.20",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
