{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.ts",
			"packages/session-backends/*/src/**/*.ts",
			"packages/session-backends/*/test/**/*.ts",
			"packages/coding-agent/examples/**/*.ts",
			"apps/omega-desktop/src/**/*.ts",
			"apps/omega-desktop/src/**/*.tsx",
			"apps/omega-desktop/electron/**/*.js",
			"apps/omega-desktop/electron/**/*.mjs",
			"apps/omega-desktop/test/**/*.mjs",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!**/models.generated.ts",
			"!**/*.models.ts",
			"!apps/omega-desktop/dist/**/*",
			"!apps/omega-desktop/release/**/*"
		]
	}
}
